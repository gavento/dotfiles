# Allowlist, not a denylist: $HOME is the work tree, so ignore everything and
# then re-include exactly what is managed.
#
# The point is `dotfiles status`. With a denylist, an untracked-file report in
# $HOME is drowned in noise (Downloads, dev checkouts, yadm's own repo.git) and
# therefore useless. With this, `status -uall` reports a NEW file appearing in
# a managed directory -- e.g. a fragment dropped into ~/.config/zsh/ -- and
# stays quiet about everything else.
#
# Re-including a path requires un-ignoring every parent directory first, hence
# the descend/exclude pairs below.

/*

!/.gitignore
!/.zshrc
!/.zshenv
!/.tmux.conf
!/.vimrc
!/.gitconfig
!/README.md
!/bootstrap.sh

!/.ssh/
/.ssh/*
!/.ssh/config

!/.config/
/.config/*
!/.config/zsh/
!/.config/yadm/

!/.local/
/.local/*

# ~/.local/bin and ~/.local/share are shared with every rootless installer on
# the box -- pip/uv/npm drop binaries, completions and man pages there. So
# these two are the one place the allowlist goes file by file instead of
# directory by directory: otherwise `dotfiles status` reports every ansible
# entry point and __pycache__ that pip ever wrote, and `update` refuses to run
# while they sit there. A new script of your own needs a line here; that is
# the price of not hearing about other people's.
!/.local/bin/
/.local/bin/*
!/.local/bin/yadm
!/.local/bin/dotfiles
!/.local/bin/tmux-window-label
!/.local/bin/jsctl
!/.local/bin/i
!/.local/bin/ipython-session.py

!/.local/share/
/.local/share/*
!/.local/share/dotfiles/
!/.local/share/man/
/.local/share/man/*
!/.local/share/man/man1/
/.local/share/man/man1/*
!/.local/share/man/man1/yadm.1
!/.local/share/zsh/
/.local/share/zsh/*
!/.local/share/zsh/functions/
/.local/share/zsh/functions/*
!/.local/share/zsh/functions/_yadm

# Machine-local escape hatches, never tracked.
/.config/zsh/local.zsh
/.config/dotfiles/
/.config/tmux/
/.config/git/local
/.ssh/config.d/
/.tmux_local.conf
