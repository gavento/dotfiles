# ssh client configuration.
#
# ORDER MATTERS: ssh uses the FIRST value obtained for each keyword, so the
# includes and host-specific blocks come before the catch-all `Host *`.

# Parse floor: OpenSSH >= 8.7 (AddKeysToAgent with a time interval).
# RequiredRSASize is 9.1+ and IgnoreUnknown'd so 8.7-9.0 clients still
# parse this file instead of dying on the unknown keyword.
IgnoreUnknown RequiredRSASize

# ---------------------------------------------------------------------------
# Per-machine hosts and overrides (gitignored). An Include glob that matches
# nothing is not an error.
# ---------------------------------------------------------------------------

Include ~/.ssh/config.d/*

# ---------------------------------------------------------------------------
# Host-specific
# ---------------------------------------------------------------------------

Host github.com
 HostName github.com
 IdentityFile ~/.ssh/gavento-github-ed25519

# ---------------------------------------------------------------------------
# Hardening, after sshaudit.com
# ---------------------------------------------------------------------------
#
# Expressed as REMOVALS from the OpenSSH defaults (the `-` prefix) rather than
# as a fixed allowlist. Re-pulled from sshaudit.com on 2026-07-26: the
# published lists are unchanged since 2024-10-01, but pinning them had turned
# into a downgrade -- OpenSSH 10 negotiates mlkem768x25519-sha256 by default,
# and an allowlist written in 2024 forced the older sntrup761x25519 instead.
#
# Subtracting keeps the hardening while letting new strong algorithms through
# as OpenSSH adds them. Defaults have caught up a lot: CBC ciphers, 3DES and
# SHA-1 key exchange are already gone upstream, so only these remain.

Host *
 # NIST-curve and small-group key exchange.
 KexAlgorithms -ecdh-sha2-nistp*,diffie-hellman-group14-sha256
 # Non-ETM constructions, 64-bit tags, and anything built on SHA-1 or MD5.
 MACs -umac-64*,hmac-sha1*,hmac-md5*,hmac-sha2-256,hmac-sha2-512,umac-128@openssh.com
 # NIST-curve host and user keys.
 HostKeyAlgorithms -ecdsa-sha2-nistp*,sk-ecdsa-sha2-nistp*
 PubkeyAcceptedAlgorithms -ecdsa-sha2-nistp*,sk-ecdsa-sha2-nistp*
 HostbasedAcceptedAlgorithms -ecdsa-sha2-nistp*,sk-ecdsa-sha2-nistp*
 CASignatureAlgorithms -ecdsa-sha2-nistp*,sk-ecdsa-sha2-nistp*
 # The OpenSSH default is 1024. Override per-host in config.d if some old
 # server still has a small host key.
 RequiredRSASize 3072

# ---------------------------------------------------------------------------
# General client settings
# ---------------------------------------------------------------------------

Host *
 AddKeysToAgent 6h
 IdentitiesOnly yes
 TCPKeepAlive yes
 Compression yes
 ServerAliveInterval 15
 ServerAliveCountMax 4

 # X11 forwarding is NOT on by default -- pass -X explicitly when you want it.
 ForwardX11 no
 ForwardX11Trusted no

 # IPv6 off by default: several of my machines sit on v4-only networks
 # where a v6 attempt just adds a connect timeout. This is
 # genuinely host-dependent -- re-enable per host in ~/.ssh/config.d/.
 AddressFamily inet

 # Default identities are machine-local: IdentityFile lines (and any Host
 # blocks that need them) live in ~/.ssh/config.d/. With IdentitiesOnly and
 # no IdentityFile at all, ssh falls back to the standard ~/.ssh/id_* names.
